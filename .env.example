# Copiază fișierul în .env și completează valorile. .env e în .gitignore.

# AI (Claude) - opțional
ANTHROPIC_API_KEY=

# Emailurile trainerilor (separate prin virgulă): intră automat ca trainer
TRAINER_EMAILS=
# Cod cu care un trainer își poate face cont, dacă emailul lui nu e mai sus
TRAINER_CODE=schimba-ma
# Codul clasei: doar cine îl are își poate face cont de student (gol = oricine)
CLASS_CODE=

# Intrare cu Google - opțional (Client ID din Google Cloud Console)
GOOGLE_CLIENT_ID=

# Conturi prin Supabase - opțional (supabase.com → Project Settings → API).
# Dacă sunt setate, parolele, emailurile de confirmare/resetare și Google merg prin Supabase.
# Pune DOAR anon key (publishable). Cheia service_role / secret nu se pune niciodată aici.
SUPABASE_URL=
SUPABASE_ANON_KEY=
