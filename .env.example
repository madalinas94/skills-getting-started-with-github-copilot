# Copiază fișierul în .env și completează valorile. .env e în .gitignore.

# AI (Claude) - opțional
ANTHROPIC_API_KEY=

# Emailurile trainerilor (separate prin virgulă): intră automat ca trainer
TRAINER_EMAILS=
# Cod cu care un trainer își poate face cont, dacă emailul lui nu e mai sus.
# Alege unul al tău (minim 6 caractere). Codurile știute de toți (ex. „trainer”) sunt ignorate.
TRAINER_CODE=
# Codul clasei: doar cine îl are își poate face cont de student (gol = oricine)
CLASS_CODE=

# Intrare cu Google - opțional (Client ID din Google Cloud Console)
GOOGLE_CLIENT_ID=

# Conturi prin Supabase - opțional (supabase.com → Project Settings → API).
# Dacă sunt setate, parolele, emailurile de confirmare/resetare și Google merg prin Supabase.
# SUPABASE_ANON_KEY e cheia publică (anon / publishable): e folosită pentru conturi.
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Datele și fișierele aplicației în Supabase (opțional, recomandat pentru publicare):
# cheia SECRETĂ (Project Settings → API Keys → secret, sb_secret_...). Stă DOAR pe server,
# în .env sau în Render → Environment. Niciodată în cod, în browser sau pe GitHub.
SUPABASE_SECRET_KEY=

# Byte, robotul de știri: briefing-ul zilei, o dată la 24 de ore
CUTIA_DIGEST_HOUR=7
CUTIA_TZ=Europe/Bucharest
# Limbile scrise dimineața (celelalte se scriu la prima vizită)
CUTIA_DIGEST_LANGS=ro,en

# Notificări push pe telefon (opțional). Generezi cheile o singură dată cu:  python -m src.webpush
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:emailul-tau@exemplu.ro

# „Verifică repo-ul” (opțional): un token GitHub doar de citire ridică limita de la 60 la 5000 de cereri pe oră
GITHUB_TOKEN=
